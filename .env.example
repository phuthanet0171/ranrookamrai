# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key (legacy) or a secret key (sb_secret_...). SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini (https://aistudio.google.com/apikey) - optional ----
# Without it the app still works and shows the rule-based summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Daily report API used by n8n ----
# Any long random string. n8n must send it in the x-report-secret header.
REPORT_SECRET=change-me-to-a-long-random-string
# Language of the emailed summary: th or en
REPORT_LANGUAGE=th
# Link shown at the bottom of the email
APP_URL=http://localhost:3000

# ---- Import page (/import) ----
# Password for uploading data. Required on a deployed site; may stay empty for npm run dev.
ADMIN_PASSWORD=

# ---- Automations: secret for /api/cron (GitHub Actions / Vercel Cron / n8n send it) ----
CRON_SECRET=
